# BIOLOG local infrastructure overrides (BIO-FND-003).
#
# Optional. docker-compose.local.yml has a safe synthetic default for every
# one of these (BIO-FND-003-AC05: no production credentials are required to
# bring the stack up) - copy this file to infrastructure/.env only if you
# need to change a port or credential locally, e.g. to avoid a clash with
# another service already using 3306/6379/etc. on your machine.
# infrastructure/.env is gitignored; never commit real values into it.

MYSQL_ROOT_PASSWORD=localroot
MYSQL_CONTROL_PORT=33061
MYSQL_TENANT_ASU_PORT=33062
MYSQL_TENANT_GRACE_PORT=33063

REDIS_PORT=6379

RABBITMQ_USER=biolog
RABBITMQ_PASSWORD=localdev
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
