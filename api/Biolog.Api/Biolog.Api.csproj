  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <!-- Microsoft.AspNetCore.OpenApi 10.0.5 pulls in Microsoft.OpenApi 2.0.0, which has a
         known high-severity advisory (GHSA-v5pm-xwqc-g5wc). The advisory's affected range
         ends at 2.7.4; 2.12.2 (the latest 2.x at the time of this pin) is patched, per
         scripts/check-dotnet-vulnerabilities.sh reporting clean at this version. Upgrading
         to the Microsoft.OpenApi 3.x major instead breaks the build (IOpenApiMediaType.Example
         became read-only, incompatible with this source generator), so stay on the patched
         2.x line rather than jumping majors. See docs/API-SHELL.md "Resolved: Microsoft.OpenApi
         advisory" (BIO-FND-008-QA-01) for the full history, including an earlier wrong claim
         that the whole 2.x line was unfixed. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />

    <!-- BIO-FND-009-AC02: OpenTelemetry hooks. Pinned to the same 1.19.0 line across all
         three packages - OpenTelemetry.Instrumentation.AspNetCore has no 1.19.1 release,
         and mismatched minor versions across the SDK/instrumentation/exporter trio is a
         known source of binding-redirect issues, so all three stay locked together. The
         console exporter is a local-development default (BIO-FND-009-AC03); a later story
         swaps it for an OTLP exporter pointed at a real collector without touching this
         module's shape. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.19.0" />
  </ItemGroup>

