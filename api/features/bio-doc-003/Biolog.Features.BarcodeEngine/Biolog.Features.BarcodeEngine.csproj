<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches api/Biolog.Api/Biolog.Api.csproj's pinned TFM (BIO-FND-008), same as BIO-DOC-001/002. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    No ASP.NET Core dependency, no NuGet package references, no image-decoding/CV library (none
    exists anywhere in this repo - docs/features/bio-doc-003/BARCODE-ENGINE.md "Why no image
    library"). Only ProjectReference is BIO-DOC-001's evidence model, this story's one declared
    dependency - deliberately NOT BIO-DOC-002's MrzEngine (not a declared dependency; this feature
    defines its own small BarcodeRaster rather than reaching for a sibling feature's raster type,
    since a shared common raster abstraction does not exist yet and inventing one here without
    Kemi's approval would be exactly the "common primitive" change the role prompt reserves for
    her - see design doc).
  -->
  <ItemGroup>
    <ProjectReference Include="../../bio-doc-001/Biolog.Features.DocumentVerify/Biolog.Features.DocumentVerify.csproj" />
  </ItemGroup>

</Project>
