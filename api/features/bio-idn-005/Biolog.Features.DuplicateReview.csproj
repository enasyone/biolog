<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- BIO-IDN-005 owns api/features/bio-idn-005/** only. No ProjectReference to
         Biolog.Api.csproj (one-way dependency, scripts/check-module-project-references.sh)
         and, deliberately, no ProjectReference to api/features/bio-idn-001's or
         bio-idn-003's projects either: each feature story owns exactly its own subtree and
         does not runtime-couple to a sibling's actual store ("Dependencies: BIO-IDN-001,
         BIO-IDN-003" in this story's metadata is build-wave/conceptual sequencing, not a
         runtime service dependency). Person/identifier attributes are instead read through
         this project's own narrow Domain/IPersonAttributeGateway.cs and
         Domain/IIdentifierAttributeGateway.cs, applying BIO-IDN-002-QA-01's existence-gateway
         lesson from the start (not after a review round) - see those interfaces' headers and
         docs/features/bio-idn-005/README.md. This absence is also this story's own AC03
         structural guarantee: without a ProjectReference to BIO-IDN-001's project, nothing
         here can call into PersonService to mutate, archive or delete a PERSON - a merge is
         structurally impossible, not merely undocumented.

         This project's own module adapter lives in api/Biolog.Api/Modules/BioIdn005Module.cs
         from the start (never written here first), matching every prior story.

         Namespace root is "DuplicateReview": the aggregate this project defines is
         DuplicateCandidate (Domain/DuplicateCandidate.cs), never a canonical ADR-0001
         identifier type of its own (see that type's header). -->
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Applying BIO-IDN-001-QA-01's lesson from the start: DuplicateCandidate's constructor
         and IDuplicateCandidateRepository/InMemoryDuplicateCandidateRepository are internal -
         this grant is the explicit, auditable seam for Biolog.Api (DI registration) and this
         project's own test assembly. -->
    <InternalsVisibleTo Include="Biolog.Api" />
    <InternalsVisibleTo Include="Biolog.Features.DuplicateReview.Tests" />
  </ItemGroup>

</Project>
