<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- BIO-VIS-002 owns api/features/bio-vis-002/** only. No ProjectReference to
         Biolog.Api.csproj (one-way dependency, scripts/check-module-project-references.sh) and no
         ProjectReference to any other feature project - a visitor record's own read/check-in/
         check-out facts are read/invoked through this project's own narrow
         Domain/IVisitorRecordGateway.cs, a backing physical card is issued/activated/deactivated
         through Domain/ICardIssuanceGateway.cs, and the grant/revoke permission check through
         Domain/IPermissionGateway.cs - all three implemented by adapters in
         api/Biolog.Api/Modules/BioVis002Module.cs wrapping BIO-VIS-001's own already-registered
         (internal, InternalsVisibleTo Biolog.Api) VisitorRecordService and BIO-CRD-005's own
         already-registered CardIssueService directly - the same gateway pattern every story in
         this codebase already uses.

         Namespace root is "VisitorCredentials". One CAS-versioned mutable aggregate -
         VisitorCredential (Domain/VisitorCredential.cs, AC02's own expiry+scope, backed by a real
         BIO-CRD-005 CardIssue) - plus a pure read-time overlay (Domain/VisitorOverstayEvaluator.cs,
         AC04's Overstay-vs-Expired split on top of BIO-VIS-001's own EffectiveVisitStatus). AC03's
         "check-out revokes/ends credential" is this story's own orchestrating CheckOutAsync, which
         is why this story takes over the real `/api/v1/visitors/{visitorId}/check-out` route
         mapping from BIO-VIS-001's own (narrowed) VisitorEndpoints.cs - see
         docs/features/bio-vis-002/README.md "Why this story edits BIO-VIS-001's own endpoint
         mapping" for the full disclosed-handoff record. -->
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every aggregate's constructor and its repository are internal - the explicit, auditable
         seam for Biolog.Api (DI registration) and this project's own test assembly. -->
    <InternalsVisibleTo Include="Biolog.Api" />
    <InternalsVisibleTo Include="Biolog.Features.VisitorCredentials.Tests" />
  </ItemGroup>

</Project>
