<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches api/Biolog.Api/Biolog.Api.csproj's pinned TFM (BIO-FND-008), same as every prior
         BIO-BIO story. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    No ASP.NET Core dependency, no NuGet package references. ProjectReference to BIO-BIO-001
    only - the same "direct reference to a plain, host-agnostic contracts library" shape every
    prior BIO-BIO story established (BiometricTemplate/IFaceProvider/IBiometricMatcher).

    The approved story also names BIO-BIO-003 (face capture and quality assessment) as a
    dependency, but deliberately NO ProjectReference exists to it here - the identical situation
    BIO-BIO-006's own csproj remarks already document for BIO-BIO-002/fingerprint search:
    BIO-BIO-003's own IFaceBiometricReferenceRepository/FaceEnrolmentService are internal,
    Scoped-registered, and expose no bulk/enumerate query at all (only get-latest-for-ONE-person),
    which a 1:N GALLERY search fundamentally needs across every enrolled identity in a tenant.
    Reaching into BIO-BIO-003's owned paths to add such a query is out of this story's write
    scope (governance/feature-path-ownership.json). This story defines its own
    Domain/IFaceGalleryStore.cs instead - a deliberately separate "search gallery" concept from
    BIO-BIO-003's own per-identity approved reference, the same architecture BIO-BIO-006 already
    established for fingerprints, populated via an explicit IndexAsync registration step (see
    docs/features/bio-bio-007/README.md "Design decisions").
  -->
  <ItemGroup>
    <ProjectReference Include="../../bio-bio-001/Biolog.Features.Biometrics/Biolog.Features.Biometrics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IFaceGalleryStore/InMemoryFaceGalleryStore, IFaceSearchAuditSink/InMemoryFaceSearchAuditSink
         and FaceSearchService are internal (BIO-IDN-001-QA-01's governance shape, mirrored by
         every prior BIO-BIO story). This is the explicit, auditable seam that grants Biolog.Api
         (DI registration in Modules/BioBio007Module.cs) and this feature's own test project the
         same access. -->
    <InternalsVisibleTo Include="Biolog.Api" />
    <InternalsVisibleTo Include="Biolog.Features.FaceSearch.Tests" />
  </ItemGroup>

</Project>
