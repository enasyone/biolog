<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- BIO-IDN-006 owns api/features/bio-idn-006/** only. No ProjectReference to
         Biolog.Api.csproj (one-way dependency, scripts/check-module-project-references.sh)
         and, deliberately, no ProjectReference to api/features/bio-idn-001's project either:
         PersonId existence is proven through this project's own narrow
         Domain/IPersonExistenceGateway.cs, applying BIO-IDN-002-QA-01's lesson from the start -
         see that interface's header and docs/features/bio-idn-006/README.md.

         This project's own module adapter lives in api/Biolog.Api/Modules/BioIdn006Module.cs
         from the start (never written here first), matching every prior story.

         Namespace root is "Rbac": the aggregates this project defines are
         PersonRoleAssignment, RolePermissionGrant, SensitiveActionRule and ApprovalRequest
         (Domain/*.cs). RoleType is a closed enum (AC01's fixed baseline catalogue); every
         other aggregate uses a natural/composite key, never a new canonical ADR-0001
         identifier type - see each aggregate's own header. -->
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Applying BIO-IDN-001-QA-01's lesson from the start: every aggregate's constructor and
         its repository are internal - this grant is the explicit, auditable seam for
         Biolog.Api (DI registration) and this project's own test assembly. -->
    <InternalsVisibleTo Include="Biolog.Api" />
    <InternalsVisibleTo Include="Biolog.Features.Rbac.Tests" />
  </ItemGroup>

</Project>
