{
  "office": "Munder BIOLOG",
  "policy_version": "1.0",
  "rules": {
    "dispatch_eligibility": {
      "statement": "Chinedu assigns a story only when all dependencies are DONE and its conflict group / owned write-scope are free.",
      "require_dependencies_done": true,
      "respect_conflict_locks": true,
      "allow_incomplete_dependencies": false,
      "ac": "BIO-FND-005-AC02"
    },
    "shared_contract_authority": {
      "statement": "Only Kemi approves shared contracts and migration sequencing.",
      "sole_approver": "Kemi",
      "ac": "BIO-FND-005-AC03"
    },
    "no_self_accept": {
      "statement": "No builder may accept its own story; acceptance is an independent acceptor.",
      "self_accept_allowed": false,
      "ac": "BIO-FND-005-AC04"
    },
    "local_first": {
      "statement": "No GitHub remote or push before the W15 gate.",
      "git_push_allowed": false,
      "remote_allowed": false,
      "github_push_enabled": false,
      "ac": "BIO-FND-005-AC05"
    }
  },
  "agents": [
    {
      "name": "Chinedu",
      "role": "Programme Orchestrator",
      "engine": "Claude Code",
      "model": "claude-opus-5",
      "permissions": {
        "dispatch": true,
        "write_feature_code": false,
        "approve_shared_contracts": false,
        "accept_stories": "only where routed as acceptor",
        "git_push": false,
        "self_accept": false
      }
    },
    {
      "name": "Kemi",
      "role": "Chief Architect & Integrator",
      "engine": "Claude Code",
      "model": "claude-opus-5",
      "permissions": {
        "write_scope": [
          "ADRs",
          "migrations",
          "shared-contracts"
        ],
        "approve_shared_contracts": true,
        "self_accept": false,
        "git_push": false
      }
    },
